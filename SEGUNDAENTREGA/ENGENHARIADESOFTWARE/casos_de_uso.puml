@startuml casos_de_uso
title Diagrama de Casos de Uso – NutriEscola (protótipo em terminal)

left to right direction
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #44546A
skinparam ActorBorderColor #2F5597
skinparam ActorBackgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #DDEBF7
  BorderColor #2F5597
}
skinparam usecase<<apoio>> {
  BackgroundColor #F2F2F2
  BorderColor #7F7F7F
}
skinparam rectangle {
  BorderColor #2F5597
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #BF9000
}

actor "Usuário do\nsistema" as U
actor "Equipe\nescolar" as ESC
actor "Equipe\nde saúde" as SAU

ESC --|> U
SAU --|> U

rectangle "NutriEscola" {
  usecase "UC01\nCadastrar ação" as UC01
  usecase "UC02\nListar ações" as UC02
  usecase "UC03\nPesquisar ações" as UC03
  usecase "UC04\nAtualizar situação" as UC04
  usecase "UC05\nRegistrar participantes" as UC05
  usecase "UC06\nGerar resumo\nestatístico" as UC06
  usecase "UC07\nEncerrar o sistema" as UC07

  usecase "Validar entradas\n(RF07)" as VAL <<apoio>>
  usecase "Localizar ação\npor código" as LOC <<apoio>>
}

U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC06
U --> UC07

UC01 ..> VAL : <<include>>
UC03 ..> VAL : <<include>>
UC04 ..> VAL : <<include>>
UC05 ..> VAL : <<include>>

UC04 ..> LOC : <<include>>
UC05 ..> LOC : <<include>>

note bottom of U
  Todos os usuários têm as mesmas permissões.
  Não existe perfil clínico: o sistema só
  registra dados coletivos e administrativos.
end note

@enduml
